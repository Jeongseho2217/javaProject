<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- xml 파일의 문법 규칙은 mybatis-3-mapper.dtd 파일의 규칙을 따라야 함
	현재 mapper가 구현할 메소드를 정의
	IProductDAO 추상메소드를 현재 mapper에서 구현해야 함
-->
<mapper namespace="com.spring_mvc.mybatis.dao.IProductDAO">
	<resultMap type="com.spring_mvc.mybatis.dto.ProductDTO" id="prdResult">
		<result property="prdNo" column="prdNo"/>
		<result property="prdName" column="prdName"/>
		<result property="prdPrice" column="prdPrice"/>
		<result property="prdCompany" column="prdCompany"/>
		<result property="prdStock" column="prdStock"/>
	</resultMap>


	<!-- 태그의 ID값과 인터페이스 추상메소드명이 동일
	반환값에 대한 내용도 태그 속성으로 전달
	여러개의 레코드가 반환됨 resultMap 사용
	한개의 레코드면 resultType을 사용
	
	ProductDTO 클래스의 필드명과 product 테이블의 컬럼명이 동일해야 함
	반환 레코드가 여러개인 경우 List타입의 콜렉션에 저장해서 반환
	ListAllProduct 추상 메소드가 반환타입이 ArrayList 타입이므로 ArrayList타입으로 반환됨
	 -->
	 <!-- 전체 상품 조회 -->
	<select id="listAllProduct" resultType="com.spring_mvc.mybatis.dto.ProductDTO">
		SELECT * FROM PRODUCT ORDER BY PRDNO
	</select>
	
	<!-- 상품 등록 void insertProduct(ProductDTO prdDto)
		매개변수의 타입을 parameterType에 value로 설정
		쿼리에 결정되지 않은 값이 매핑되어야 할 때는 place holder를 사용
		#{} 또는 ${} 중 하나를 사용함
		${}는 statement 객체의 변수 역할을 함, 재사용이 가능한 #{}를 더 많이 사용
	 -->
	<insert id="insertProduct" parameterType="com.spring_mvc.mybatis.dto.ProductDTO">
		INSERT INTO product(prdNo, prdName, prdPrice, prdCompany, prdStock, prdDate)
		VALUES (#{prdNo}, #{prdName}, #{prdPrice}, #{prdCompany}, #{prdStock}, #{prdDate})
	</insert>
	
	<!-- 상품 정보 상세 조회: 조건절이 있는 select 
		파라미터와 result가 모두 있는 태그로 구성해야 함
	-->
	
	<select id="detailViewProduct" parameterType="string" resultType="com.spring_mvc.mybatis.dto.ProductDTO">
		SELECT * FROM product WHERE prdNo=#{prdNo}
	</select>
	
	<!-- 상품 정보 수정: 기본키인 상픔번호는 수정 x -->
	
	<update id="updateProduct" parameterType="com.spring_mvc.mybatis.dto.ProductDTO">
		UPDATE product SET prdName=#{prdName}, prdPrice=#{prdPrice},
		prdConpany=#{prdConpany}, prdStock=#{prdStock}, prdDate=#{prdDate} WHERE prdNo=#{prdNo}
	</update>
	
	<!-- 상품 정보 삭제 -->
	<delete id="deleteProduct" parameterType="String">
		DELETE FROM product WHERE prdNo=#{prdNo}
	</delete>
</mapper>